<%@ Page Language="C#" CodePage="65001" CodeBehind="DeliveryUploadPDA.aspx.cs" AutoEventWireup="false" Inherits="ModuleWorkFlow.DeliveryUploadPDA" MasterPageFile="~/DefaultPDASub.Master" %>
<asp:Content ID="PdaContent" ContentPlaceHolderID="contentHolder" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server" />
    <asp:UpdatePanel ID="upPdaContent" runat="server" UpdateMode="Conditional">
        <ContentTemplate>
            <style type="text/css">
                .delivery-pda-section{margin:8px;padding:10px;border-radius:6px;background:#fff;border:1px solid #d8dee5}.delivery-pda-section h2{margin:0 0 8px;font-size:18px}.delivery-pda-dock{position:sticky;top:0;z-index:10;margin:8px;padding:10px;background:#f4f6f8}.delivery-pda-scan{width:100%;min-height:58px;padding:8px;font-size:20px;border:3px solid #1769aa;border-radius:5px;background:#fffbd9}.delivery-pda-scan:focus{outline:3px solid #ffb000;outline-offset:1px}.delivery-pda-type{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px;font-size:16px}.delivery-pda-type label{margin-right:10px}.delivery-pda-state{display:block;margin-bottom:8px;padding:10px;border-radius:6px;color:#fff;text-align:center;font-size:20px;font-weight:800;background:#1769aa}.delivery-pda-message{display:block;margin:8px;padding:10px;border-radius:4px;font-weight:700;background:#eef2f5}.delivery-pda-field{margin:7px 0}.delivery-pda-field label{display:block;margin-bottom:3px;font-weight:700}.delivery-pda-readonly,.delivery-pda-required{width:100%;min-height:40px;padding:7px;border:1px solid #c9d2dc;border-radius:4px;word-break:break-all}.delivery-pda-readonly{background:#f5f7f9}.delivery-pda-required{background:#fffbd9}.delivery-pda-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:5px}.delivery-pda-summary>div{padding:7px 4px;border-radius:4px;background:#eef2f5}.delivery-pda-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.delivery-pda-button{width:100%;min-height:48px;margin-top:8px;border:0;border-radius:5px;font-size:17px;font-weight:700;background:#1769aa;color:#fff}.delivery-pda-button:disabled{background:#9aa4af;color:#e5e7eb}.delivery-pda-radio-disabled{color:gray!important}.delivery-pda-radio-enabled{color:black!important}
            </style>
            <div class="delivery-pda-dock">
                <asp:Label ID="Label_PdaState" runat="server" CssClass="delivery-pda-state" Text="请先扫描 KD 标签" />
                <asp:TextBox ID="txt_ScanQRCode" runat="server" CssClass="delivery-pda-scan" AutoPostBack="true" OnTextChanged="txt_ScanQRCode_TextChanged" />
                <div class="delivery-pda-type"><asp:RadioButtonList ID="rblScanType" runat="server" RepeatDirection="Horizontal"><asp:ListItem Value="KD" Selected="True">KD 标签</asp:ListItem><asp:ListItem Value="Packing">配送单</asp:ListItem></asp:RadioButtonList></div>
            </div>
            <div class="delivery-pda-section"><h2>配送单信息</h2>
                <div class="delivery-pda-summary"><div><label>供货批次号</label><asp:TextBox ID="txt_DeliverySupplyBatchNo" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div><div><label>零件编号</label><asp:TextBox ID="txt_DeliveryPartNo" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div></div>
                <div class="delivery-pda-summary"><div><label>数量</label><asp:TextBox ID="txt_DeliveryQty" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div><div><label>随箱卡流水号</label><asp:TextBox ID="txt_SxCardSeq" runat="server" CssClass="delivery-pda-required" AutoPostBack="true" OnTextChanged="txt_SxCardSeq_TextChanged" /></div></div>
                <div class="delivery-pda-field"><label>包装单编号</label><asp:TextBox ID="txt_DeliveryPackageCode" runat="server" CssClass="delivery-pda-required" /></div>
                <div class="delivery-pda-field"><label>包装名称</label><asp:TextBox ID="txt_DeliveryPackageName" runat="server" CssClass="delivery-pda-required" /></div>
                <div class="delivery-pda-field"><label>配送单号</label><asp:TextBox ID="txt_DeliveryNo" runat="server" CssClass="delivery-pda-required" /></div>
                <div class="delivery-pda-field"><label>核验结果</label><asp:TextBox ID="txt_DeliveryMatch" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div>
                <asp:DropDownList ID="dpl_baseno" runat="server" Style="display:none"><asp:ListItem Value="" Text="" /></asp:DropDownList><asp:HiddenField ID="hidPendingMessage" runat="server" />
            </div>
            <div class="delivery-pda-actions"><asp:Button ID="btn_upload" runat="server" Text="上传配送单" OnClick="btn_upload_Click" OnClientClick="this.value='上传中...';window.setTimeout(function(){this.disabled=true;}.bind(this),0);" CssClass="delivery-pda-button" Enabled="false" /><asp:Button ID="btn_rescan" runat="server" Text="重新扫描" OnClick="btn_rescan_Click" CssClass="delivery-pda-button" Enabled="false" /></div>
            <div class="delivery-pda-section"><h2>KD 标签信息</h2>
                <div class="delivery-pda-field"><label>供货批次号</label><asp:TextBox ID="txt_KdSupplyBatchNo" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div>
                <div class="delivery-pda-field"><label>零件编号</label><asp:TextBox ID="txt_KdPartNo" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div>
                <div class="delivery-pda-summary"><div><label>箱号</label><asp:TextBox ID="txt_KdCartonNo" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div><div><label>计划数量</label><asp:TextBox ID="txt_KdQty" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div></div>
                <div class="delivery-pda-field"><label>零件名称</label><asp:TextBox ID="txt_KdPartName" runat="server" ReadOnly="true" CssClass="delivery-pda-readonly" /></div>
            </div>
        </ContentTemplate>
        <Triggers><asp:AsyncPostBackTrigger ControlID="txt_ScanQRCode" EventName="TextChanged" /><asp:AsyncPostBackTrigger ControlID="txt_SxCardSeq" EventName="TextChanged" /><asp:AsyncPostBackTrigger ControlID="btn_upload" EventName="Click" /><asp:AsyncPostBackTrigger ControlID="btn_rescan" EventName="Click" /></Triggers>
    </asp:UpdatePanel>
    <div id="deliveryPdaMessageModal" class="delivery-pda-modal-mask" role="alertdialog" aria-modal="true" aria-labelledby="deliveryPdaMessageModalTitle"><div class="delivery-pda-modal" onclick="event.stopPropagation();"><div id="deliveryPdaMessageModalTitle" class="delivery-pda-modal-title">提示</div><div id="deliveryPdaMessageModalBody" class="delivery-pda-modal-body"></div><div class="delivery-pda-modal-actions"><button type="button" onclick="hideMessageModal();">确定</button></div></div></div>
</asp:Content>
<asp:Content ID="PdaScripts" ContentPlaceHolderID="JSHolder" runat="server"><style type="text/css">.delivery-pda-modal-mask{position:fixed;inset:0;z-index:2000;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.62)}.delivery-pda-modal{width:100%;max-width:460px;padding:18px;border-radius:8px;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,.35)}.delivery-pda-modal-title{padding-bottom:10px;border-bottom:1px solid #dee2e6;font-size:20px;font-weight:700}.delivery-pda-modal-body{padding:14px 0;word-break:break-word}.delivery-pda-modal-actions{display:flex}.delivery-pda-modal-actions button{width:100%;min-height:44px}</style><script type="text/javascript">
window.showMessageModal=function(message){var mask=document.getElementById('deliveryPdaMessageModal');var body=document.getElementById('deliveryPdaMessageModalBody');if(!mask||!body){window.alert(message||'');focusDeliveryScanSoon();return}body.innerText=message||'';mask.style.display='flex';var button=mask.querySelector('button');if(button)button.focus()};window.hideMessageModal=function(){var mask=document.getElementById('deliveryPdaMessageModal');if(mask)mask.style.display='none';focusDeliveryScanSoon();};
function deliveryScanKeyDown(event){event=event||window.event;var keyCode=event.which||event.keyCode;if(keyCode===13){if(event.preventDefault)event.preventDefault();__doPostBack('<%=txt_ScanQRCode.UniqueID%>','');return false}return true}
function updateDeliveryRadioStyles(){var e=document.getElementById('<%=rblScanType.ClientID%>');if(!e)return;var l=e.getElementsByTagName('label'),i=e.getElementsByTagName('input');for(var n=0;n<i.length&&n<l.length;n++)l[n].className=i[n].disabled?'delivery-pda-radio-disabled':'delivery-pda-radio-enabled'}
function focusDeliveryScan(){var e=document.getElementById('<%=txt_ScanQRCode.ClientID%>');if(e&&!e.disabled){e.focus();try{e.select()}catch(x){}}}function focusDeliveryScanSoon(){window.setTimeout(focusDeliveryScan,50);window.setTimeout(focusDeliveryScan,200)}
(function(){function showPendingMessage(){var e=document.getElementById('<%=hidPendingMessage.ClientID%>');if(!e||!e.value)return;var message=e.value;e.value='';window.setTimeout(function(){if(window.showMessageModal)showMessageModal(message);},0)}function ready(){var e=document.getElementById('<%=txt_ScanQRCode.ClientID%>');if(e){e.setAttribute('autocomplete','off');e.setAttribute('onkeydown','return deliveryScanKeyDown(event);')}updateDeliveryRadioStyles();showPendingMessage();focusDeliveryScanSoon()}if(window.Sys&&Sys.WebForms){Sys.WebForms.PageRequestManager.getInstance().add_endRequest(ready)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready);else ready()})();
</script></asp:Content>
