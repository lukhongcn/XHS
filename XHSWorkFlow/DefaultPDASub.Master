<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="DefaultPDASub.Master.cs" Inherits="ModuleWorkFlow.DefaultPDASub" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title><%= PageTitle %></title>
    <link href="<%= ResolveUrl("~/css/bootstrap.min.css") %>" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="headHolder" runat="server" />
    <style type="text/css">
        * { box-sizing: border-box; }
        html, body, form { margin: 0; padding: 0; min-height: 100%; width: 100%; }
        body { background: #f4f6f8; color: #20252b; font-size: 16px; overflow-x: hidden; }
        .pda-topbar { min-height: 52px; display: flex; align-items: center; gap: 8px; padding: 4px 8px; background: #17324d; color: #fff; }
        .pda-topbar-title { flex: 1; font-size: 18px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .pda-topbar a, .pda-topbar button { min-height: 44px; padding: 8px 12px; border: 1px solid rgba(255,255,255,.65); border-radius: 4px; background: transparent; color: #fff; text-decoration: none; font-size: 16px; }
        .pda-page { width: 100%; max-width: 520px; margin: 0 auto; padding-bottom: 12px; }
        .pda-content { width: 100%; }
        button, input, select, textarea { font: inherit; }
        .pda-topbar a:active, .pda-topbar button:active, button:active { opacity: .72; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <header class="pda-topbar">
            <a href="javascript:history.back();" aria-label="返回">返回</a>
            <div class="pda-topbar-title"><%= PageTitle %></div>
            <a href="<%= ResolveUrl("~/login.aspx") %>" target="_parent">登出</a>
        </header>
        <main class="pda-page">
            <asp:ContentPlaceHolder ID="contentHolder" runat="server" />
        </main>
    </form>
    <asp:ContentPlaceHolder ID="JSHolder" runat="server" />
</body>
</html>
