{
  "profileId": "PART_PROCESS_DECISION",
  "pageTitle": "工序质量判定 PDA",
  "permission": {
    "read": "PQUERY",
    "write": "PEDIT"
  },
  "query": {
    "processId": "QMJCPD",
    "statusId": "Ready"
  },
  "customerMap": {
    "SQSD": "上汽时代",
    "XWD": "欣旺达"
  },
  "ui": {
    "scanInput": {
      "id": "txtQRCode",
      "title": "扫描 QRCode",
      "command": "SCAN"
    },
    "processGrid": {
      "source": "view.readyPartProcesses",
      "columns": [
        { "field": "RowNumber", "title": "序号", "type": "index" },
        { "field": "Customer", "title": "客户" },
        { "field": "PartNo_Id", "title": "零件编号" },
        { "field": "ScannedCode", "title": "零件编码" },
        { "field": "ReplaceQRCode", "title": "替换QRCode" },
        { "field": "ProcessNo", "title": "ProcessNo", "visible": false },
        { "field": "ActionText", "title": "操作" }
      ]
    },
    "actionDialog": {
      "title": "请选择处理动作",
      "actions": [
        {
          "code": "RECHECK",
          "text": "重新检测",
          "color": "#5B9BD5",
          "textColor": "#FFFFFF",
          "operatorId": "partprocess.recheck.execute",
          "targetStatusId": "Ready"
        },
        {
          "code": "SCRAP",
          "text": "报废",
          "color": "#FFD966",
          "textColor": "#333333",
          "operatorId": "partprocess.scrap.execute",
          "targetStatusId": "Rejected"
        },
        {
          "code": "PACK",
          "text": "直接装箱",
          "color": "#D9534F",
          "textColor": "#FFFFFF",
          "operatorId": "partprocess.pack.execute",
          "targetStatusId": "Implementation"
        }
      ]
    }
  }
}
